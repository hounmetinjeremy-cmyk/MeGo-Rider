{
  "expo": {
    "name": "MeGo",
    "slug": "mego-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#FFFFFF" },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.megorider.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MeGo utilise votre position pour vous proposer les commandes les plus proches.",
        "NSPhotoLibraryUsageDescription": "MeGo utilise vos photos pour illustrer vos produits."
      }
    },
    "android": {
      "package": "com.megorider.app",
      "versionCode": 1,
      "adaptiveIcon": { "backgroundColor": "#76D865" },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET"
      ]
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "MeGo utilise vos photos pour illustrer vos produits."
        }
      ]
    ]
  }
}
