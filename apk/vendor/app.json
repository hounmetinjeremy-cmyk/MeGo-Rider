{
  "expo": {
    "name": "MeGo Vendeur",
    "slug": "mego-vendeur-apk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#0a7d4b" },
    "android": {
      "package": "com.mego.vendeur",
      "versionCode": 1,
      "adaptiveIcon": { "backgroundColor": "#0a7d4b" },
      "permissions": ["INTERNET", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MeGo Vendeur utilise ta position pour que les livreurs trouvent ta boutique.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
